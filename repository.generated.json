{
  "schemaVersion": 1,
  "repository": "YanChao001/serial-workbench-plugins",
  "config": {
    "schemaVersion": 1,
    "hosting": {
      "provider": "github",
      "repositoryUrlTemplate": "https://github.com/{repository}",
      "links": {
        "file": "{repositoryUrl}/blob/{ref}/{path}",
        "tree": "{repositoryUrl}/tree/{ref}/{path}",
        "commit": "{repositoryUrl}/commit/{ref}",
        "commits": "{repositoryUrl}/commits/{ref}",
        "compare": "{repositoryUrl}/compare/{base}...{ref}",
        "release": "{repositoryUrl}/releases/tag/{tag}"
      }
    },
    "host": {
      "repository": "YanChao001/serial-workbench",
      "repositoryUrl": "https://github.com/YanChao001/serial-workbench",
      "docsRef": "main",
      "defaultRef": "main"
    },
    "wallpaperUserAgentTemplate": "SerialWorkbenchWallpaper/2.0 ({repositoryUrl})"
  }
}
